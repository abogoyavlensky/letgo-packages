{:paths ["src"]

 :deps {;; Bindings for the stdlib API the veneer sits on. No driver here —
        ;; that is what keeps this package driver-agnostic; drivers (sqlite,
        ;; postgres) depend on this package and add their own.
        database/sql {:go/interop "sql"}

        ;; The hand-written seam, released as the nested Go module tagged
        ;; sql/shim/vX.Y.Z. To work on it, flip this to {:go/local "shim"}
        ;; locally and do not commit that (see "Releasing" in the root README).
        github.com/abogoyavlensky/letgo-packages/sql/shim {:go/version "v0.1.0"}}}

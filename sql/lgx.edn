{:paths ["src"]

 ;; For this package's own `lgx test`. A consumer's runtime decision is its
 ;; own: lgx ignores a dep's top-level keys.
 :lg-runtime :built
 :lg-version "1.13.0"

 :deps {;; Bindings for the stdlib API the veneer sits on. No driver here —
        ;; that is what keeps this package driver-agnostic; drivers (sqlite,
        ;; postgres) depend on this package and add their own.
        database/sql {:go/interop "sql"}

        ;; The hand-written seam. It ships inside the sql-vX.Y.Z package tag
        ;; as a local module: there is no separate Go module tag
        ;; (sql/shim/v0.1.0 stays as history). lgx 0.4.2 or newer reuses the
        ;; built runtime until the shim's files change.
        github.com/abogoyavlensky/letgo-packages/sql/shim {:go/local "shim"}}}

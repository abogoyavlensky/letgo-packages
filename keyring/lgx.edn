{:paths ["src"]

 ;; For this package's own `lgx test`. A consumer's runtime decision is its
 ;; own: lgx ignores a dep's top-level keys.
 :lg-runtime :built
 :lg-version "1.13.0"

 :deps {;; The hand-written seam, and the only Go in the package. It ships
        ;; inside the keyring-vX.Y.Z package tag as a local module: there is
        ;; no separate Go module tag. go-keyring arrives through the shim's
        ;; own go.mod, so the package declares no :go/interop.
        github.com/abogoyavlensky/letgo-packages/keyring/shim {:go/local "shim"}}}

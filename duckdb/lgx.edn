{:paths ["src"]

 ;; For this package's own `lgx test`. A consumer's runtime decision is its
 ;; own: lgx ignores a dep's top-level keys.
 :lg-runtime :built
 :lg-version "1.13.0"

 :deps {;; The driver-agnostic layer: database/sql bindings, the shim, and
        ;; the sql.core veneer all arrive transitively from here.
        abogoyavlensky/letgo-sql {:local/root "../sql"}

        ;; NOT pure Go: the driver is cgo over a prebuilt static libduckdb, so
        ;; builds need a C toolchain and cannot cross-compile (see README).
        ;; Link-only: it registers itself with database/sql as "duckdb". Keep
        ;; the version equal to the require in shim/go.mod.
        github.com/duckdb/duckdb-go/v2 {:go/version "v2.10505.0"}

        ;; The hand-written seam: converts DuckDB's Go values into plain
        ;; let-go values. :go/local while the wrapper is unreleased; becomes
        ;; {:go/version "vX.Y.Z"} when it is tagged (see "Releasing" in the
        ;; root README).
        github.com/abogoyavlensky/letgo-packages/duckdb/shim {:go/local "shim"}}}

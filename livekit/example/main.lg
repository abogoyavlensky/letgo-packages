;; End-to-end exercise of the livekit package: an SFU embedded in this
;; binary as an integrant component, started, called and stopped. Every
;; check throws on a mismatch, so a clean exit is the pass signal.
(ns main
  (:require [http]
            [integrant.core :as ig]
            [livekit.core :as lk]
            [livekit.integrant]
            [string :as str]))

(def api-key "devkey")
(def api-secret "secretsecretsecretsecretsecretsecret")

(def config
  {:port 7890
   :bind_addresses ["127.0.0.1"]
   :rtc {:tcp_port 7891
         :port_range_start 50000
         :port_range_end 50100
         :use_external_ip false}
   :keys {api-key api-secret}
   :logging {:level "warn"}})

(defn- check! [what ok?]
  (when-not ok?
    (throw (ex-info (str "check failed: " what) {})))
  (println "ok:" what))

(defn- room-service!
  "POST a RoomService call to the local server as a token holder."
  [method token body]
  (http/post (str "http://127.0.0.1:7890/twirp/livekit.RoomService/" method)
             body
             {:headers {"Authorization" (str "Bearer " token)}
              :content-type "application/json"}))

;; A stand-in for an app's own component: it depends on the server, the
;; way a real handler would to mint tokens against it.
(defmethod ig/init-key :app/handler [_ {:keys [livekit]}]
  {:livekit livekit})

(def system-config
  {:livekit/server {:config config}
   :app/handler {:livekit (ig/ref :livekit/server)}})

(defn -main []
  (let [system (ig/init system-config)
        server (:livekit/server system)]
    (check! "server is running" (lk/running? server))
    (check! "the handler holds the server"
            (identical? server (:livekit (:app/handler system))))
    (check! "http port is 7890" (= 7890 (lk/http-port server)))
    (let [admin (lk/token api-key api-secret
                          {:identity "example-admin" :room-create true})
          resp (room-service! "CreateRoom" admin "{\"name\":\"demo\"}")]
      (check! "CreateRoom answers 200" (= 200 (:status resp)))
      (check! "the created room is named demo"
              (str/includes? (:body resp) "\"demo\"")))
    (ig/halt! system)
    (check! "server is stopped" (not (lk/running? server)))))

;; Nothing above starts a server at load time, and this guard keeps
;; `lgx build` from starting one while it bundles.
(when-not *compiling-aot*
  (-main))

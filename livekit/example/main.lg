(ns main
  (:require [livekit.shim :as shim]))

(let [s (shim/Start {:port 7890
                     :bind_addresses ["127.0.0.1"]
                     :rtc {:tcp_port 7891 :port_range_start 50000
                           :port_range_end 50100 :use_external_ip false}
                     :keys {"devkey" "secretsecretsecretsecretsecretsecret"}
                     :logging {:level "warn"}})]
  (println (shim/Running s))
  (shim/Stop s false))

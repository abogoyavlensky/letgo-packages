{:paths ["src"]

 ;; The hand-written seam, and the only Go in the stack. :go/local while
 ;; the wrapper is unreleased; becomes {:go/version "vX.Y.Z"} when it is
 ;; tagged. Wails itself arrives through the shim's own go.mod — this
 ;; package generates no bindings, so it declares no :go/interop.
 :deps {github.com/abogoyavlensky/letgo-packages/wails/shim {:go/local "shim"}}}

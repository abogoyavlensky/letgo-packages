;; End-to-end exercise of the postgres driver package over the sql layer,
;; against a live server:
;;
;;   docker run --rm -d --name letgo-pg -e POSTGRES_PASSWORD=letgo \
;;     -p 5432:5432 postgres:17
;;
;; Mirrors the sqlite example so the two drivers are directly comparable,
;; plus the types Postgres has that SQLite does not: timestamptz and
;; numeric. The DSN comes from LETGO_PG_DSN, defaulting to the container
;; above.
(ns main
  (:require [postgres.core :as db]))

(defn- dsn []
  (let [v (os/getenv "LETGO_PG_DSN")]
    (if (string/blank? v)
      "postgres://postgres:letgo@localhost:5432/postgres"
      v)))

(defn- check [label ok]
  (if ok
    (println " ✓" label)
    (do (println " ✗" label)
        (throw (ex-info (str "assertion failed: " label) {})))))

(defn -main []
  (let [conn (db/open (dsn))]
    (try
      ;; execute! for DDL
      (db/execute! conn ["drop table if exists people"])
      (db/execute! conn ["create table people (id serial primary key,
                                               name text not null,
                                               age integer,
                                               height real,
                                               active boolean,
                                               notes text,
                                               born timestamptz,
                                               balance numeric)"])

      ;; execute! for parameterized inserts ($1-style placeholders)
      (let [r (db/execute! conn ["insert into people (name, age, height, active, notes, born, balance)
                                  values ($1, $2, $3, $4, $5, to_timestamp($6), $7)"
                                 "Ada" 36 1.63 true nil 1700000000 "12.34"])]
        (check "insert returns [{:sql/update-count 1}]"
               (= [{:sql/update-count 1}] r)))
      (db/execute! conn ["insert into people (name, age, height, active, notes)
                          values ($1, $2, $3, $4, $5)"
                         "Grace" 45 1.5 false "COBOL"])

      ;; query -> vector of row maps
      (let [rows (db/query conn ["select id, name, age, height, active, notes
                                  from people order by id"])]
        (check "query returns two rows" (= 2 (count rows)))
        (let [ada (first rows)]
          (check "text is a native string" (= "Ada" (:name ada)))
          (check "integer round-trips" (= 36 (:age ada)))
          (check "float round-trips (real)" (< 1.62 (:height ada) 1.64))
          (check "boolean round-trips as true" (= true (:active ada)))
          (check "NULL is nil" (nil? (:notes ada)))
          (check "id was assigned" (= 1 (:id ada)))))

      ;; timestamptz: the driver returns time.Time; compare through epoch
      (let [row (db/execute-one! conn ["select born,
                                               extract(epoch from born)::bigint as epoch
                                        from people where name = $1" "Ada"])]
        (check "timestamptz epoch round-trips" (= 1700000000 (:epoch row)))
        (check "timestamptz value round-trips (.Unix)"
               (= 1700000000 (.Unix (:born row)))))

      ;; numeric: assert the exact decimal text survives
      (let [row (db/execute-one! conn ["select balance, balance::text as bal_text
                                        from people where name = $1" "Ada"])]
        (check "numeric text round-trips" (= "12.34" (:bal_text row)))
        (check "numeric column is readable" (= "12.34" (str (:balance row)))))

      ;; execute-one! -> first row or nil
      (let [grace (db/execute-one! conn ["select name, active, notes from people
                                          where age > $1" 40])]
        (check "execute-one! returns the row map" (= "Grace" (:name grace)))
        (check "false round-trips" (= false (:active grace)))
        (check "text round-trips" (= "COBOL" (:notes grace))))
      (check "execute-one! is nil on empty result"
             (nil? (db/execute-one! conn ["select * from people where age > $1" 99])))

      ;; execute-one! on DML -> {:sql/update-count n}
      (let [r (db/execute-one! conn ["update people set notes = $1 where name = $2"
                                     "analytical engine" "Ada"])]
        (check "execute-one! DML returns {:sql/update-count 1}"
               (= {:sql/update-count 1} r)))

      ;; INSERT ... RETURNING takes the rows path via the heuristic
      (let [r (db/execute-one! conn ["insert into people (name, age) values ($1, $2)
                                      returning id, name" "Alan" 41])]
        (check "insert returning yields the row" (= "Alan" (:name r)))
        (check "returned id is an integer" (= 3 (:id r))))

      ;; with-transaction committing
      (db/with-transaction [tx conn]
        (db/execute! tx ["insert into people (name, age) values ($1, $2)" "Edsger" 72])
        (db/execute! tx ["update people set age = $1 where name = $2" 37 "Ada"]))
      (check "transaction committed"
             (= 4 (:n (db/execute-one! conn ["select count(*) as n from people"]))))
      (check "update inside transaction landed"
             (= 37 (:age (db/execute-one! conn ["select age from people where name = $1"
                                                "Ada"]))))

      ;; with-transaction rolling back on a throw
      (let [thrown (try
                     (db/with-transaction [tx conn]
                       (db/execute! tx ["insert into people (name, age) values ($1, $2)"
                                        "Nobody" 1])
                       (throw (ex-info "boom" {}))
                       :not-reached)
                     (catch Throwable e (ex-message e)))]
        (check "the body's exception is rethrown" (= "boom" thrown)))
      (check "rollback undid the insert"
             (nil? (db/execute-one! conn ["select * from people where name = $1"
                                          "Nobody"])))

      ;; :keys default is :unqualified-lower here (Postgres folds unquoted
      ;; identifiers anyway; quoted ones prove the lower-casing)
      (let [row (db/execute-one! conn ["select name as \"MixedCase\" from people
                                        where name = $1" "Ada"])]
        (check "default :unqualified-lower lower-cases quoted columns"
               (= "Ada" (:mixedcase row))))

      ;; :returns override forces the update-count path
      (let [r (db/execute! conn ["select 1"] {:returns :update-count})]
        (check "{:returns :update-count} overrides the heuristic"
               (= :sql/update-count (first (keys (first r))))))

      ;; exploratory: text[] — database/sql has no portable array scanning,
      ;; so this records what actually happens rather than asserting
      (let [outcome (try
                      (let [row (db/execute-one!
                                  conn
                                  ["select array['a','b']::text[] as arr"])]
                        (str "value: " (pr-str (:arr row))))
                      (catch Throwable e (str "error: " (ex-message e))))]
        (println " ~ text[] (exploratory):" outcome))

      (println "all checks passed")
      (finally (db/close! conn)))))

(when-not *compiling-aot* (-main))

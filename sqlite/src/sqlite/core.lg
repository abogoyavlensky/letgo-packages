;; sqlite.core — the sqlite driver package: open/close! plus re-exports of
;; the driver-agnostic sql.core API, so a consumer needs one require.
;;
;; The driver is modernc.org/sqlite (pure Go), which registers itself with
;; database/sql as "sqlite" when the runtime links it.
(ns sqlite.core
  (:require [sql]
            [sql.core]))

(def ^:private driver "sqlite")

(defn open
  "Open the sqlite database at `path` (\":memory:\" for an in-memory one).
   Returns a connectable for the fns below. opts become the connection's
   defaults — e.g. {:keys :unqualified-lower} — merged under per-call opts."
  ([path] (open path nil))
  ([path opts]
   {:sql/handle (sql/Open driver path)
    :sql/opts (merge {:keys :unqualified} opts)}))

(defn close!
  "Close a connectable (or bare handle). Returns the close error as a
   value, nil on success."
  [conn]
  (.Close (if (map? conn) (:sql/handle conn) conn)))

(def execute!
  "See sql.core/execute!."
  sql.core/execute!)

(def execute-one!
  "See sql.core/execute-one!."
  sql.core/execute-one!)

(def query
  "See sql.core/query."
  sql.core/query)

(defmacro with-transaction
  "See sql.core/with-transaction."
  [bindings & body]
  `(sql.core/with-transaction ~bindings ~@body))
